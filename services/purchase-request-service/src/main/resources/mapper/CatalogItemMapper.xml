<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eprocure.pr.infrastructure.persistence.mapper.CatalogItemMapper">

    <sql id="searchWhereClause">
        WHERE is_deleted = false
        <if test="categoryCode != null and categoryCode != ''">
            AND category_code = #{categoryCode}
        </if>
        <if test="query != null and query != ''">
            AND to_tsvector('simple', name || ' ' || COALESCE(description,'')) @@ plainto_tsquery('simple', #{query})
        </if>
    </sql>

    <select id="search" resultType="com.eprocure.pr.infrastructure.persistence.entity.CatalogItemDbEntity">
        SELECT *
        FROM pr.catalog_items
        <include refid="searchWhereClause"/>
        ORDER BY created_at DESC
        OFFSET #{offset} LIMIT #{limit}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM pr.catalog_items
        <include refid="searchWhereClause"/>
    </select>

</mapper>
