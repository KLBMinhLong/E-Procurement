<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eprocure.finance.infrastructure.persistence.mapper.PoPrConversionCallbackMapper">

    <resultMap id="poPrConversionCallbackResultMap"
               type="com.eprocure.finance.infrastructure.persistence.entity.PoPrConversionCallbackDbEntity">
        <id property="id" column="id"/>
        <result property="poId" column="po_id"/>
        <result property="prId" column="pr_id"/>
        <result property="idempotencyKey" column="idempotency_key"/>
        <result property="status" column="status"/>
        <result property="attempts" column="attempts"/>
        <result property="nextRetryAt" column="next_retry_at"/>
        <result property="deliveredAt" column="delivered_at"/>
        <result property="lastError" column="last_error"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByPoIds" resultMap="poPrConversionCallbackResultMap">
        SELECT id, po_id, pr_id, idempotency_key, status, attempts,
               next_retry_at, delivered_at, last_error, created_at
        FROM finance.po_pr_conversion_callbacks
        WHERE po_id IN
        <foreach collection="poIds" item="poId" open="(" separator="," close=")">
            #{poId}
        </foreach>
    </select>
</mapper>
