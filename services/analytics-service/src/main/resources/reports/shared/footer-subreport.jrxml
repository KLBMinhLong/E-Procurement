<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="footer-subreport"
              pageWidth="555"
              pageHeight="40"
              columnWidth="555"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0">

    <parameter name="GENERATED_AT" class="java.time.Instant"/>
    <parameter name="PAGE_NUMBER" class="java.lang.Integer"/>
    <parameter name="TOTAL_PAGES" class="java.lang.Integer"/>

    <pageFooter>
        <band height="40">
            <!-- Separator line -->
            <line>
                <reportElement x="0" y="3" width="555" height="1" forecolor="#E2E8F0"/>
            </line>

            <!-- Generated info left -->
            <textField>
                <reportElement x="0" y="8" width="280" height="14" forecolor="#A0AEC0"/>
                <textElement>
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + ($P{GENERATED_AT} != null ? $P{GENERATED_AT}.toString() : "")]]></textFieldExpression>
            </textField>

            <!-- Confidential notice center -->
            <staticText>
                <reportElement x="150" y="8" width="255" height="14" forecolor="#A0AEC0"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="7" isItalic="true"/>
                </textElement>
                <text><![CDATA[eProcure Enterprise — Confidential]]></text>
            </staticText>

            <!-- Page number right -->
            <textField>
                <reportElement x="455" y="8" width="100" height="14" forecolor="#A0AEC0"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $P{PAGE_NUMBER} + " of " + $P{TOTAL_PAGES}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>