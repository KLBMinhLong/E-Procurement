<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="header-subreport"
              pageWidth="555"
              pageHeight="80"
              columnWidth="555"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="REPORT_SUBTITLE" class="java.lang.String"/>
    <parameter name="LOGO_PATH" class="java.lang.String"/>

    <title>
        <band height="80">
            <!-- Dark navy banner -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="55" backcolor="#1A365D"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <!-- Logo nếu có -->
            <image>
                <reportElement x="15" y="10" width="30" height="30"/>
                <imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression>
            </image>

            <!-- Company name -->
            <staticText>
                <reportElement x="50" y="8" width="250" height="22" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="15" isBold="true"/>
                </textElement>
                <text><![CDATA[eProcure Enterprise]]></text>
            </staticText>

            <!-- Subtitle -->
            <staticText>
                <reportElement x="300" y="12" width="240" height="18" forecolor="#CBD5E0"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Internal Analytics & Reports]]></text>
            </staticText>

            <!-- Confidential notice -->
            <staticText>
                <reportElement x="300" y="32" width="240" height="14" forecolor="#A0AEC0"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="7" isItalic="true"/>
                </textElement>
                <text><![CDATA[CONFIDENTIAL — Internal Use Only]]></text>
            </staticText>

            <!-- Gold accent line -->
            <rectangle>
                <reportElement x="0" y="55" width="555" height="2" backcolor="#C9A96E"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <!-- Report title -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="60" width="555" height="20" forecolor="#1A365D"/>
                <textElement>
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <!-- Report subtitle -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="75" width="555" height="15" forecolor="#718096"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_SUBTITLE}]]></textFieldExpression>
            </textField>
        </band>
    </title>
</jasperReport>