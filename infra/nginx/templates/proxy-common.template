proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Request-ID $request_id;
proxy_set_header Cookie $http_cookie;
proxy_connect_timeout 5s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;

# Handle CORS preflight OPTIONS requests
if ($request_method = 'OPTIONS') {
    add_header Access-Control-Allow-Origin "${CORS_ALLOWED_ORIGINS}" always;
    add_header Access-Control-Allow-Credentials "true" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Request-ID, Idempotency-Key, X-API-Key" always;
    add_header Access-Control-Max-Age 86400;
    add_header Content-Type text/plain;
    add_header Content-Length 0;
    return 204;
}

# CORS headers
add_header Access-Control-Allow-Origin "${CORS_ALLOWED_ORIGINS}" always;
add_header Access-Control-Allow-Credentials "true" always;
add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Request-ID, Idempotency-Key, X-API-Key" always;
add_header Access-Control-Expose-Headers "X-Request-ID, X-Correlation-ID" always;
