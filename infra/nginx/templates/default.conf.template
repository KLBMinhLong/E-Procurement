server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    client_max_body_size 20m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location /api/v1/auth/ {
        set $upstream "${IAM_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/users/ {
        set $upstream "${IAM_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/roles/ {
        set $upstream "${IAM_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/org/ {
        set $upstream "${IAM_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/purchase-requests/ {
        set $upstream "${PR_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/catalog/ {
        set $upstream "${PR_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/approvals/ {
        set $upstream "${APPROVAL_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/budgets/ {
        set $upstream "${FINANCE_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/purchase-orders/ {
        set $upstream "${FINANCE_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/invoices/ {
        set $upstream "${FINANCE_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/items/ {
        set $upstream "${INVENTORY_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/warehouses/ {
        set $upstream "${INVENTORY_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/goods-receipts/ {
        set $upstream "${INVENTORY_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/vendors/ {
        set $upstream "${VENDOR_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/rfq/ {
        set $upstream "${VENDOR_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/dashboard/ {
        set $upstream "${ANALYTICS_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/kpi/ {
        set $upstream "${ANALYTICS_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/reports/ {
        set $upstream "${ANALYTICS_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/notifications/ {
        set $upstream "${NOTIFICATION_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /ws/notifications/ {
        set $upstream "${NOTIFICATION_SERVICE_URL}";
        proxy_pass $upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location /api/v1/admin/ {
        set $upstream "${ADMIN_SERVICE_URL}";
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-common.conf;
    }

    location / {
        add_header Content-Type application/json;
        return 404 '{"success":false,"code":"GW_404","message":"Route not found","data":null,"meta":null}';
    }
}
