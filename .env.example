# eProcure local development environment
# Copy this file to .env before running docker compose.

COMPOSE_PROJECT_NAME=eprocure
TZ=Asia/Ho_Chi_Minh
SPRING_PROFILES_ACTIVE=dev
ENCRYPTION_ENABLED=false
X_API_KEY=dev-internal-api-key-change-me

# Host ports
GATEWAY_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_EXTERNAL_PORT=19092
KEYCLOAK_PORT=18080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# PostgreSQL admin
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASS=postgres_dev_pass

# Service database users
IAM_DB_USER=iam_user
IAM_DB_PASS=iam_pass_dev
PR_DB_USER=pr_user
PR_DB_PASS=pr_pass_dev
APPROVAL_DB_USER=approval_user
APPROVAL_DB_PASS=approval_pass_dev
FINANCE_DB_USER=finance_user
FINANCE_DB_PASS=finance_pass_dev
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASS=inventory_pass_dev
VENDOR_DB_USER=vendor_user
VENDOR_DB_PASS=vendor_pass_dev
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASS=notification_pass_dev
AUDIT_DB_USER=audit_user
AUDIT_DB_PASS=audit_pass_dev
CAMUNDA_DB_USER=camunda_user
CAMUNDA_DB_PASS=camunda_pass_dev
ANALYTICS_DB_USER=analytics_ro
ANALYTICS_DB_PASS=analytics_pass_dev

# Redis
REDIS_HOST=redis
REDIS_PASS=
SESSION_TTL_HOURS=8
PERM_CACHE_TTL_MINUTES=15
IDEMPOTENCY_TTL_HOURS=24

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=eprocure-dev
KAFKA_AUTO_OFFSET_RESET=earliest

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin_dev_pass
KEYCLOAK_REALM=eprocure
KEYCLOAK_CLIENT_ID=eprocure-iam
KEYCLOAK_CLIENT_SECRET=dev-secret

# Gateway upstream defaults. App services are added in later skeleton steps.
IAM_SERVICE_URL=http://iam-service:8081
PR_SERVICE_URL=http://pr-service:8082
APPROVAL_SERVICE_URL=http://approval-service:8083
FINANCE_SERVICE_URL=http://finance-service:8084
INVENTORY_SERVICE_URL=http://inventory-service:8085
VENDOR_SERVICE_URL=http://vendor-service:8086
ANALYTICS_SERVICE_URL=http://analytics-service:8087
NOTIFICATION_SERVICE_URL=http://notification-service:8088
ADMIN_SERVICE_URL=http://admin-service:8089
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=admin_dev_pass
