# eProcure local development environment
# Copy this file to .env before running docker compose.

COMPOSE_PROJECT_NAME=eprocure
TZ=Asia/Ho_Chi_Minh
SPRING_PROFILES_ACTIVE=dev
ENCRYPTION_ENABLED=false
X_API_KEY=dev-internal-api-key-change-me
RSA_KEY_VERSION=v2025-01
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=

# Host ports
GATEWAY_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_EXTERNAL_PORT=19092
KEYCLOAK_PORT=18080
IAM_SERVICE_PORT=8081
FINANCE_SERVICE_PORT=8084
INVENTORY_SERVICE_PORT=8085
VENDOR_SERVICE_PORT=8086
ANALYTICS_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# PostgreSQL admin
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASS=postgres_dev_pass

# Service database users
IAM_DB_USER=iam_user
IAM_DB_PASS=iam_pass_dev
PR_DB_USER=pr_user
PR_DB_PASS=pr_pass_dev
APPROVAL_DB_USER=approval_user
APPROVAL_DB_PASS=approval_pass_dev
FINANCE_DB_USER=finance_user
FINANCE_DB_PASS=finance_pass_dev
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASS=inventory_pass_dev
VENDOR_DB_USER=vendor_user
VENDOR_DB_PASS=vendor_pass_dev
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASS=analytics_pass_dev
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASS=notification_pass_dev
AUDIT_DB_USER=audit_user
AUDIT_DB_PASS=audit_pass_dev
CAMUNDA_DB_USER=camunda_user
CAMUNDA_DB_PASS=camunda_pass_dev

# Redis
REDIS_HOST=redis
REDIS_PASS=
SESSION_TTL_HOURS=8
PERM_CACHE_TTL_MINUTES=15
IDEMPOTENCY_TTL_HOURS=24

# Kafka
KAFKA_CLUSTER_ID=8F4Qf35tQ2e8rE9rQ9k8wA
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=eprocure-dev
KAFKA_AUTO_OFFSET_RESET=earliest
PR_INTEGRATION_FALLBACK_ENABLED=false
PR_FINANCE_INTEGRATION_ENABLED=true
PR_DEFAULT_GL_ACCOUNT_CODE=6002
FINANCE_KAFKA_ENABLED=true
FINANCE_DEFAULT_GL_ACCOUNT_CODE=6002
FINANCE_KAFKA_TOPIC_GR_CREATED=inventory.gr.created
FINANCE_KAFKA_TOPIC_INVOICE_MATCHED=finance.invoice.matched
INVENTORY_KAFKA_ENABLED=true
INVENTORY_KAFKA_AUTO_STARTUP=true
NOTIFICATION_KAFKA_ENABLED=true
NOTIFICATION_KAFKA_AUTO_STARTUP=true
NOTIFICATION_KAFKA_TOPIC_INVOICE_MATCHED=finance.invoice.matched    
NOTIFICATION_BUDGET_ALERT_RECIPIENT_IDS=10000000-0000-4000-8000-000000000001
NOTIFICATION_EMAIL_DISPATCH_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=logging
NOTIFICATION_EMAIL_BATCH_SIZE=25
NOTIFICATION_EMAIL_RETRY_FIXED_DELAY_MS=60000
EMAIL_RETRY_MAX=3
EMAIL_RETRY_DELAY_SECONDS=30
EMAIL_FROM_NAME=eProcure Dev
EMAIL_FROM_ADDRESS=dev@eprocure.local
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
APPROVAL_INTEGRATION_FALLBACK_ENABLED=false

# Approval SLA
SLA_ZONE_ID=Asia/Ho_Chi_Minh
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=17:30
BUSINESS_DAYS=MON,TUE,WED,THU,FRI
SLA_WARNING_AHEAD_HOURS=4
SLA_CHECK_INTERVAL_MINUTES=15
EMERGENCY_SLA_HOURS=2
EMERGENCY_L2_SLA_HOURS=4

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin_dev_pass
KEYCLOAK_REALM=eprocure
KEYCLOAK_CLIENT_ID=eprocure-iam
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client-secret
IAM_PROVIDER_BASE_URL=http://iam-service:8081
IAM_PROVIDER_TIMEOUT_SECONDS=3
IAM_INTERNAL_API_KEY=change-me-internal-api-key
PR_INTERNAL_API_KEY=change-me-internal-api-key
APPROVAL_INTERNAL_API_KEY=change-me-internal-api-key
FINANCE_INTERNAL_API_KEY=change-me-internal-api-key
INVENTORY_INTERNAL_API_KEY=change-me-internal-api-key
VENDOR_INTERNAL_API_KEY=change-me-internal-api-key
ANALYTICS_INTERNAL_API_KEY=change-me-internal-api-key
NOTIFICATION_INTERNAL_API_KEY=change-me-internal-api-key
NGINX_INTERNAL_API_KEY=change-me-internal-api-key

# ── IAM Password Reset ───────────────────────────────────────
RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_FRONTEND_URL=http://localhost:4200/reset-password
IAM_PASSWORD_RESET_DELIVERY_MODE=kafka
IAM_PASSWORD_RESET_TOPIC=notification.email.send
IAM_PASSWORD_RESET_LANGUAGE=vi

# ── IAM 2FA ─────────────────────────────────────────────────
TWO_FACTOR_ISSUER=eProcure Dev
TOTP_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_STATE_TTL_MINUTES=5

# Gateway upstream defaults. App services are added in later skeleton steps.
IAM_SERVICE_URL=http://iam-service:8081
PR_SERVICE_URL=http://pr-service:8082
PR_INTERNAL_API_KEY=change-me-internal-api-key
APPROVAL_INTERNAL_API_KEY=change-me-internal-api-key
FINANCE_INTERNAL_API_KEY=change-me-internal-api-key
INVENTORY_INTERNAL_API_KEY=change-me-internal-api-key
VENDOR_INTERNAL_API_KEY=change-me-internal-api-key
ANALYTICS_INTERNAL_API_KEY=change-me-internal-api-key
NOTIFICATION_INTERNAL_API_KEY=change-me-internal-api-key
NGINX_INTERNAL_API_KEY=change-me-internal-api-key
ANALYTICS_KAFKA_ENABLED=true
ANALYTICS_KAFKA_AUTO_STARTUP=true
ANALYTICS_KAFKA_TOPIC_PO_ISSUED=procurement.po.issued
ANALYTICS_KAFKA_TOPIC_INVOICE_MATCHED=finance.invoice.matched
ANALYTICS_KAFKA_TOPIC_APPROVAL_SLA_BREACHED=approval.sla.breached
APPROVAL_SERVICE_URL=http://approval-service:8083
FINANCE_SERVICE_URL=http://finance-service:8084
INVENTORY_SERVICE_URL=http://inventory-service:8085
VENDOR_SERVICE_URL=http://vendor-service:8086
ANALYTICS_SERVICE_URL=http://analytics-service:8087
NOTIFICATION_SERVICE_URL=http://notification-service:8088
ADMIN_SERVICE_URL=http://admin-service:8089
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=admin_dev_pass
