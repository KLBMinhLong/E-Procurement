## 6. JENKINS CI/CD PIPELINE

```groovy
// Jenkinsfile (mẫu chuẩn cho mỗi service)
pipeline {
    agent any
    environment {
        SERVICE_NAME = 'pr-service'
        DOCKER_REGISTRY = 'registry.eprocure.internal'
        DOCKER_IMAGE = "${DOCKER_REGISTRY}/${SERVICE_NAME}"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile -DskipTests'
            }
        }

        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/**/*.xml'
                    jacoco(
                        execPattern: 'target/jacoco.exec',
                        classPattern: 'target/classes',
                        sourcePattern: 'src/main/java',
                        minimumInstructionCoverage: '70'    // Fail nếu < 70%
                    )
                }
            }
        }

        stage('Code Quality') {
            steps {
                sh 'mvn checkstyle:check'
                // sh 'mvn sonar:sonar' (nếu có SonarQube)
            }
        }

        stage('Integration Test') {
            when { branch 'develop' }
            steps {
                sh 'mvn verify -P integration-test'
                // Chạy Postman collection
                sh '''
                    newman run tests/postman/${SERVICE_NAME}.postman_collection.json \
                        --environment tests/postman/dev.postman_environment.json \
                        --reporters cli,junit \
                        --reporter-junit-export target/newman-results.xml
                '''
            }
            post {
                always {
                    junit 'target/newman-results.xml'
                }
            }
        }

        stage('Build Docker Image') {
            when { anyOf { branch 'develop'; branch 'main' } }
            steps {
                script {
                    def imageTag = env.BRANCH_NAME == 'main'
                        ? env.GIT_TAG_NAME ?: 'latest'
                        : "dev-${env.GIT_COMMIT[0..7]}"
                    sh "docker build -t ${DOCKER_IMAGE}:${imageTag} ."
                    sh "docker push ${DOCKER_IMAGE}:${imageTag}"
                }
            }
        }

        stage('Deploy Dev') {
            when { branch 'develop' }
            steps {
                sh '''
                    docker-compose -f docker-compose.dev.yml pull ${SERVICE_NAME}
                    docker-compose -f docker-compose.dev.yml up -d ${SERVICE_NAME}
                '''
            }
        }

        stage('Deploy Prod') {
            when { branch 'main' }
            steps {
                input message: "Deploy ${SERVICE_NAME} lên Production?", ok: "Deploy"
                sh '''
                    docker-compose -f docker-compose.prod.yml pull ${SERVICE_NAME}
                    docker-compose -f docker-compose.prod.yml up -d --no-deps ${SERVICE_NAME}
                '''
            }
        }

        stage('Smoke Test') {
            when { branch 'main' }
            steps {
                sh '''
                    sleep 30   # Chờ service khởi động
                    curl -f http://${SERVICE_NAME}:8080/actuator/health || exit 1
                '''
            }
        }
    }
    post {
        failure {
            // Gửi thông báo Slack/Email khi fail (nếu có)
            echo "Build FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
        }
        success {
            echo "Build SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
        }
    }
}
```

