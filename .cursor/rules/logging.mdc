## 5. LOG4J2 CONFIGURATION

```xml
<!-- resources/log4j2.xml -->
<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- Dev: màu ANSI cho terminal -->
        <Property name="DEV_PATTERN">
            %highlight{%d{HH:mm:ss.SSS}}{FATAL=red bold, ERROR=red, WARN=yellow bold, INFO=green, DEBUG=cyan, TRACE=white}
            %style{[%-15t]}{bright,black}
            %-5level
            %style{[%logger{1}]}{cyan}
            %style{traceId=%X{traceId}}{bright,blue}
            - %msg%n%xThrowable{short}
        </Property>

        <!-- Prod: JSON cho Loki ingest -->
        <Property name="JSON_PATTERN">
            {"ts":"%d{ISO8601}","level":"%level","svc":"${env:SERVICE_NAME:-unknown}",
            "traceId":"%X{traceId}","spanId":"%X{spanId}","thread":"%t",
            "logger":"%logger{1}","msg":"%enc{%msg}{JSON}"%xThrowable{JSON}}%n
        </Property>
    </Properties>

    <Appenders>
        <!-- Console: dev màu sắc, prod JSON -->
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout pattern="${env:SPRING_PROFILES_ACTIVE:-dev}" />
            <!-- Sẽ resolve từ Spring profile, xem config bên dưới -->
        </Console>

        <!-- App log: rolling daily -->
        <RollingFile name="APP" fileName="logs/application.log"
                     filePattern="logs/application-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${JSON_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="100MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- Audit log: APPEND ONLY — không rotate, không xóa -->
        <File name="AUDIT" fileName="logs/audit.log" append="true">
            <PatternLayout pattern="${JSON_PATTERN}"/>
        </File>

        <!-- Error log riêng để alert dễ hơn -->
        <RollingFile name="ERROR" fileName="logs/error.log"
                     filePattern="logs/error-%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${JSON_PATTERN}"/>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <Policies><TimeBasedTriggeringPolicy /></Policies>
            <DefaultRolloverStrategy max="90"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- App code: DEBUG trong dev, INFO trong prod -->
        <Logger name="com.eprocure" level="${env:LOG_LEVEL_APP:-INFO}" additivity="false">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="APP"/>
            <AppenderRef ref="ERROR"/>
        </Logger>

        <!-- Audit log riêng biệt -->
        <Logger name="com.eprocure.audit" level="INFO" additivity="false">
            <AppenderRef ref="AUDIT"/>
        </Logger>

        <!-- Tắt verbose logs của framework -->
        <Logger name="org.springframework"          level="WARN"/>
        <Logger name="org.mybatis"                  level="WARN"/>
        <Logger name="com.zaxxer.hikari"            level="WARN"/>
        <Logger name="org.apache.kafka"             level="WARN"/>
        <Logger name="io.lettuce"                   level="WARN"/>
        <Logger name="org.camunda"                  level="WARN"/>

        <Root level="${env:LOG_LEVEL_ROOT:-INFO}">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="APP"/>
            <AppenderRef ref="ERROR"/>
        </Root>
    </Loggers>
</Configuration>
```

