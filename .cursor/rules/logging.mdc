## 4. SENSITIVE DATA MASKING — BẮT BUỘC

### 4.1 Danh sách TUYỆT ĐỐI không log
```
password, newPassword, confirmPassword, oldPassword
token, accessToken, refreshToken, ep_session
totpSecret, backupCodes
rsaPrivateKey, aesKey, encryptedPayload, encryptedAesKey
apiKey, x-api-key, clientSecret
creditCard, bankAccount, cvv
```

### 4.2 LogMaskingUtil
```java
public final class LogMaskingUtil {

    private LogMaskingUtil() {}

    // nguyen.van.a@company.com → n***@c***.com
    public static String maskEmail(String email) {
        if (email == null || !email.contains("@")) return "***";
        String[] parts = email.split("@");
        String local = parts[0].length() > 1
            ? parts[0].charAt(0) + "***"
            : "***";
        String domain = parts[1].length() > 3
            ? parts[1].charAt(0) + "***." + getTopLevelDomain(parts[1])
            : "***";
        return local + "@" + domain;
    }

    // 0912345678 → 09*****678
    public static String maskPhone(String phone) {
        if (phone == null || phone.length() < 6) return "***";
        return phone.substring(0, 2)
            + "*".repeat(phone.length() - 5)
            + phone.substring(phone.length() - 3);
    }

    // UUID → chỉ show 8 ký tự đầu
    public static String maskId(UUID id) {
        if (id == null) return "null";
        return id.toString().substring(0, 8) + "...";
    }

    // Token → chỉ show 8 ký tự đầu
    public static String maskToken(String token) {
        if (token == null || token.length() < 8) return "***";
        return token.substring(0, 8) + "...";
    }

    // Tên người dùng → Nguyễn V. A.
    public static String maskName(String fullName) {
        if (fullName == null) return "***";
        String[] parts = fullName.split(" ");
        if (parts.length == 1) return parts[0].charAt(0) + "***";
        StringBuilder sb = new StringBuilder(parts[0]);
        for (int i = 1; i < parts.length; i++) {
            sb.append(" ").append(parts[i].charAt(0)).append(".");
        }
        return sb.toString();
    }
}
```

