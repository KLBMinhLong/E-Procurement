## 6. QUERY PERFORMANCE RULES

```sql
-- ✅ Luôn dùng EXPLAIN ANALYZE để kiểm tra trước khi commit query phức tạp
EXPLAIN ANALYZE
SELECT p.*, a.status as approval_status
FROM pr.purchase_requests p
LEFT JOIN approval.approval_processes a ON a.entity_id = p.id AND a.entity_type = 'PURCHASE_REQUEST'
WHERE p.department_id = 'uuid'
  AND p.is_deleted = FALSE
  AND p.status = 'PENDING_APPROVAL'
ORDER BY p.created_at DESC
LIMIT 20 OFFSET 0;

-- ✅ Dùng window function COUNT(*) OVER() thay vì 2 queries riêng
SELECT
    p.*,
    COUNT(*) OVER() AS total_count   -- Tổng record (cho pagination)
FROM pr.purchase_requests p
WHERE p.is_deleted = FALSE
LIMIT #{page.size} OFFSET #{page.offset};

-- ✅ JOIN optimization — INNER JOIN trước LEFT JOIN
SELECT p.*, d.name as dept_name, u.full_name as requester_name
FROM pr.purchase_requests p
INNER JOIN iam.departments d ON d.id = p.department_id   -- INNER trước
LEFT JOIN iam.users u ON u.id = p.requester_id           -- LEFT sau
WHERE p.is_deleted = FALSE;

-- ❌ KHÔNG dùng SELECT * trong production query
SELECT * FROM pr.purchase_requests;    -- ❌ Lấy tất cả column không cần thiết

-- ✅ Chỉ select columns cần thiết
SELECT id, pr_number, title, status, total_amount, created_at
FROM pr.purchase_requests
WHERE is_deleted = FALSE;

-- ❌ KHÔNG N+1 query — dùng JOIN hoặc IN clause
-- Xấu: query 1 lần lấy IDs, rồi query từng ID
-- Tốt: JOIN hoặc WHERE id IN (...)
```

