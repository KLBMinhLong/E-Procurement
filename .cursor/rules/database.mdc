# DATABASE RULES — eProcure Enterprise

## 1. SCHEMA & NAMING

```sql
-- ✅ KHÔNG dùng schema 'public' — mỗi service có schema riêng
CREATE SCHEMA IF NOT EXISTS iam;        -- IAM Service
CREATE SCHEMA IF NOT EXISTS pr;         -- PR Service
CREATE SCHEMA IF NOT EXISTS approval;   -- Approval Engine
CREATE SCHEMA IF NOT EXISTS finance;    -- Finance Service
CREATE SCHEMA IF NOT EXISTS inventory;  -- Inventory Service
CREATE SCHEMA IF NOT EXISTS vendor;     -- Vendor Service
CREATE SCHEMA IF NOT EXISTS notification; -- Notification Service
CREATE SCHEMA IF NOT EXISTS audit;      -- Audit Log (immutable)
-- Camunda tự quản lý schema của nó

-- ✅ Table names: lowercase_snake_case, plural
CREATE TABLE pr.purchase_requests (...);      -- ✅
CREATE TABLE pr.PurchaseRequests (...);       -- ❌
CREATE TABLE pr.purchase_request (...);       -- ❌ (không plural)

-- ✅ Column names: lowercase_snake_case
pr_number VARCHAR(20) NOT NULL,               -- ✅
prNumber  VARCHAR(20) NOT NULL,               -- ❌
PRNumber  VARCHAR(20) NOT NULL,               -- ❌
```

