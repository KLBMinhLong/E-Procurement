## 7. GENERATED COLUMNS & TRIGGERS

```sql
-- ✅ Generated column cho computed values (PostgreSQL 12+)
CREATE TABLE pr.pr_line_items (
    ...
    quantity    NUMERIC(10,2) NOT NULL,
    unit_price  NUMERIC(19,4) NOT NULL,
    total_price NUMERIC(19,4) NOT NULL
        GENERATED ALWAYS AS (quantity * unit_price) STORED,  -- ✅ Auto-computed
    ...
);

-- ✅ Trigger để auto-update updated_at
CREATE OR REPLACE FUNCTION iam.update_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_users_updated_at
    BEFORE UPDATE ON iam.users
    FOR EACH ROW
    EXECUTE FUNCTION iam.update_updated_at();

-- Áp dụng trigger này cho MỌI entity table
```

