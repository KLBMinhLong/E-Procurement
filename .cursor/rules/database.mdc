## 4. INDEX STRATEGY

```sql
-- ✅ Index cho EVERY Foreign Key column
CREATE INDEX idx_pr_line_items_pr_id
    ON pr.pr_line_items(pr_id);

-- ✅ Partial index cho soft delete queries (WHERE is_deleted = false)
CREATE INDEX idx_pr_status_active
    ON pr.purchase_requests(status)
    WHERE is_deleted = FALSE;

CREATE INDEX idx_pr_requester_active
    ON pr.purchase_requests(requester_id)
    WHERE is_deleted = FALSE;

-- ✅ Composite index cho common query patterns
CREATE INDEX idx_pr_dept_status
    ON pr.purchase_requests(department_id, status)
    WHERE is_deleted = FALSE;

CREATE INDEX idx_approval_steps_approver_pending
    ON approval.approval_steps(approver_id, status)
    WHERE status = 'PENDING';

-- ✅ Index cho timestamp-based queries (DESC vì query mới nhất trước)
CREATE INDEX idx_pr_created_at
    ON pr.purchase_requests(created_at DESC)
    WHERE is_deleted = FALSE;

-- ✅ Partial index cho SLA deadline monitoring
CREATE INDEX idx_approval_steps_sla_pending
    ON approval.approval_steps(sla_deadline)
    WHERE status = 'PENDING';

-- ✅ Full-text search index (GIN)
CREATE INDEX idx_catalog_items_fts
    ON pr.catalog_items
    USING GIN(to_tsvector('simple', name || ' ' || COALESCE(description, '')));

-- ✅ UNIQUE index (prefer over UNIQUE constraint cho flexibility)
CREATE UNIQUE INDEX idx_users_email_unique
    ON iam.users(email)
    WHERE is_deleted = FALSE;       -- Partial unique: cho phép soft-delete rồi tạo lại cùng email

-- ❌ KHÔNG index tràn lan — chỉ index khi có query cần
-- Mỗi index = overhead cho INSERT/UPDATE
-- Rule: có query thực tế mới tạo index
```

