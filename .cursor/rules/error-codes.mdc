## 5. API RESPONSE ENVELOPE

```java
// ✅ Generic response wrapper
@Getter
@JsonInclude(JsonInclude.Include.NON_NULL)
public class ApiResponse<T> {

    private final boolean success;
    private final String code;
    private final String message;
    private final T data;
    private final List<FieldErrorDetail> details;     // Chỉ có khi validation error
    private final PageMeta meta;                       // Chỉ có khi phân trang
    private final String timestamp;
    private final String requestId;

    private ApiResponse(boolean success, String code, String message,
                        T data, List<FieldErrorDetail> details, PageMeta meta) {
        this.success = success;
        this.code = code;
        this.message = message;
        this.data = data;
        this.details = details;
        this.meta = meta;
        this.timestamp = Instant.now().toString();
        this.requestId = MDC.get("traceId");    // OpenTelemetry trace ID
    }

    // ✅ Factory methods
    public static <T> ApiResponse<T> success(String code, T data) {
        return new ApiResponse<>(true, code, null, data, null, null);
    }

    public static <T> ApiResponse<T> success(String code, T data, PageMeta meta) {
        return new ApiResponse<>(true, code, null, data, null, meta);
    }

    public static <T> ApiResponse<T> ok(String code, String message) {
        return new ApiResponse<>(true, code, message, null, null, null);
    }

    public static <T> ApiResponse<T> error(String code, String message) {
        return new ApiResponse<>(false, code, message, null, null, null);
    }

    public static <T> ApiResponse<T> validationError(
            String code, String message, List<FieldErrorDetail> details) {
        return new ApiResponse<>(false, code, message, null, details, null);
    }
}

// ✅ Field error detail
public record FieldErrorDetail(String field, String reason, Object rejectedValue) {}
```

