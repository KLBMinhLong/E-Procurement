## 3. EXCEPTION HIERARCHY

```java
// ✅ Base exception — abstract, không throw trực tiếp
public abstract class BusinessException extends RuntimeException {
    private final String errorCode;
    private final HttpStatus httpStatus;

    protected BusinessException(String errorCode, String message, HttpStatus httpStatus) {
        super(message);
        this.errorCode = errorCode;
        this.httpStatus = httpStatus;
    }

    protected BusinessException(PrErrorCode errorCode) {
        this(errorCode.getCode(), errorCode.getDefaultMessage(), errorCode.getHttpStatus());
    }

    // Getter only — immutable
    public String getErrorCode() { return errorCode; }
    public HttpStatus getHttpStatus() { return httpStatus; }
}

// ✅ Domain exceptions — 1 class = 1 loại lỗi nghiệp vụ rõ ràng
public class PrNotFoundException extends BusinessException {
    public PrNotFoundException(String prNumber) {
        super(PrErrorCode.PR_NOT_FOUND.getCode(),
              "Yêu cầu mua sắm không tồn tại: " + prNumber,
              HttpStatus.NOT_FOUND);
    }
}

public class InsufficientBudgetException extends BusinessException {
    public InsufficientBudgetException(BigDecimal available, BigDecimal required) {
        super(PrErrorCode.INSUFFICIENT_BUDGET.getCode(),
              String.format("Ngân sách không đủ. Còn lại: %s VND, cần: %s VND",
                  NumberFormat.format(available), NumberFormat.format(required)),
              HttpStatus.UNPROCESSABLE_ENTITY);
    }
}

public class InvalidStateTransitionException extends BusinessException {
    public InvalidStateTransitionException(PrStatus current, String action) {
        super(PrErrorCode.INVALID_STATE_TRANSITION.getCode(),
              String.format("Không thể '%s' khi PR đang ở trạng thái %s", action, current),
              HttpStatus.CONFLICT);
    }
}

// ✅ Technical exceptions — để tách biệt với domain
public class ExternalServiceException extends BusinessException {
    public ExternalServiceException(String serviceName, String detail) {
        super("SYS_002",
              "Dịch vụ " + serviceName + " không khả dụng",
              HttpStatus.SERVICE_UNAVAILABLE);
    }
}
```

