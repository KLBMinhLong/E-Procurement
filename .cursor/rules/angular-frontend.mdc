## 7. ROUTING & LAZY LOADING

```typescript
// ✅ app-routing.module.ts
const routes: Routes = [
    { path: '', redirectTo: '/dashboard', pathMatch: 'full' },
    { path: 'login', component: LoginComponent },
    {
        path: '',
        component: ShellComponent,
        canActivate: [AuthGuard],
        children: [
            {
                path: 'dashboard',
                loadChildren: () => import('./features/analytics/analytics.module')
                    .then(m => m.AnalyticsModule)
            },
            {
                path: 'procurement',
                loadChildren: () => import('./features/procurement/procurement.module')
                    .then(m => m.ProcurementModule),
                canActivate: [PermissionGuard],
                data: { requiredPermission: 'PR_VIEW_OWN' }
            },
            {
                path: 'approvals',
                loadChildren: () => import('./features/approvals/approvals.module')
                    .then(m => m.ApprovalsModule),
                canActivate: [PermissionGuard],
                data: { requiredPermission: 'PR_APPROVE_L1' }
            },
            {
                path: 'admin',
                loadChildren: () => import('./features/admin/admin.module')
                    .then(m => m.AdminModule),
                canActivate: [PermissionGuard],
                data: { requiredPermission: 'ADMIN_USER_VIEW' }
            },
            {
                path: 'system-config',
                loadChildren: () => import('./features/system-config/system-config.module')
                    .then(m => m.SystemConfigModule),
                canActivate: [PermissionGuard],
                data: { requiredPermission: 'SYSTEM_CONFIG' }
            },
            {
                path: 'ui-showcase',
                loadChildren: () => import('./ui-showcase/ui-showcase.module')
                    .then(m => m.UiShowcaseModule)
            }
        ]
    },
    { path: 'forbidden', component: ForbiddenComponent },
    { path: '**', component: NotFoundComponent }
];
```

