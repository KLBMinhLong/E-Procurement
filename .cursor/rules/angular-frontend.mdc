## 2. COMPONENT RULES

```typescript
// ✅ Template chuẩn cho feature component
@Component({
    selector: 'ep-pr-list',
    templateUrl: './pr-list.component.html',
    styleUrls: ['./pr-list.component.scss'],
    changeDetection: ChangeDetectionStrategy.OnPush,  // ✅ Luôn OnPush
    standalone: false                                  // Dùng NgModule pattern
})
export class PrListComponent implements OnInit {

    // ── Injections (inject() function, không constructor) ─────
    private readonly prService = inject(PurchaseRequestService);
    private readonly router = inject(Router);
    private readonly destroyRef = inject(DestroyRef);

    // ── State ─────────────────────────────────────────────────
    purchaseRequests = signal<PurchaseRequestSummary[]>([]);
    meta = signal<PageMeta | null>(null);
    isLoading = signal<boolean>(false);
    currentFilter = signal<PrFilter>({ page: 1, size: 20, sort: 'createdAt,desc' });

    // ── Lifecycle ────────────────────────────────────────────
    ngOnInit(): void {
        this.loadData();
    }

    // ── Public Methods ───────────────────────────────────────
    onPageChange(event: PageChangeEvent): void {
        this.currentFilter.update(f => ({ ...f, page: event.page, size: event.size }));
        this.loadData();
    }

    onFilterChange(filter: Partial<PrFilter>): void {
        this.currentFilter.update(f => ({ ...f, ...filter, page: 1 }));
        this.loadData();
    }

    navigateToDetail(prNumber: string): void {
        this.router.navigate(['/procurement', prNumber]);
    }

    // ── Private Methods ──────────────────────────────────────
    private loadData(): void {
        this.isLoading.set(true);
        this.prService.list(this.currentFilter())
            .pipe(
                takeUntilDestroyed(this.destroyRef),   // ✅ Auto unsubscribe
                finalize(() => this.isLoading.set(false))
            )
            .subscribe({
                next: response => {
                    this.purchaseRequests.set(response.data);
                    this.meta.set(response.meta);
                },
                error: err => {
                    // Error interceptor đã xử lý toast — không cần làm thêm
                    console.error('Load PR list failed', err);
                }
            });
    }
}
```

### Component Rules
```
□ ChangeDetectionStrategy.OnPush LUÔN LUÔN
□ inject() thay vì constructor injection
□ takeUntilDestroyed(this.destroyRef) cho mọi subscription
□ Signals cho state management
□ KHÔNG có business logic trong component — delegate sang service
□ Template KHÔNG có phép tính phức tạp — dùng computed signals
□ Selector prefix ep- cho shared components
```

