## 6. API SERVICE & INTERCEPTORS

```typescript
// ✅ Base API service với typed response
@Injectable({ providedIn: 'root' })
export class ApiService {
    private readonly http = inject(HttpClient);
    private readonly baseUrl = inject(API_BASE_URL);  // InjectionToken

    get<T>(path: string, params?: Record<string, string>): Observable<ApiResponse<T>> {
        return this.http.get<ApiResponse<T>>(`${this.baseUrl}${path}`, {
            params,
            withCredentials: true    // ✅ Gửi HttpOnly cookie
        });
    }

    post<T>(path: string, body: unknown, idempotencyKey?: string): Observable<ApiResponse<T>> {
        const key = idempotencyKey ?? crypto.randomUUID();
        return this.http.post<ApiResponse<T>>(`${this.baseUrl}${path}`, body, {
            withCredentials: true,
            headers: { 'Idempotency-Key': key }
        });
    }
}

// ✅ Error interceptor — xử lý tập trung
@Injectable()
export class ErrorInterceptor implements HttpInterceptor {
    private readonly toast = inject(ToastService);
    private readonly router = inject(Router);
    private readonly authService = inject(AuthService);

    intercept(req: HttpRequest<unknown>, next: HttpHandler): Observable<HttpEvent<unknown>> {
        return next.handle(req).pipe(
            catchError((error: HttpErrorResponse) => {
                const body = error.error as ApiResponse<never>;
                const code = body?.code;

                switch (code) {
                    case 'IAM_003':
                    case 'IAM_005':
                        // Token hết hạn → logout và redirect login
                        this.authService.clearSession();
                        this.router.navigate(['/login']);
                        break;
                    case 'IAM_004':
                        // Không có quyền
                        this.router.navigate(['/forbidden']);
                        break;
                    case 'GW_001':
                        // Rate limit
                        this.toast.warning('Vui lòng thử lại sau 30 giây');
                        break;
                    case 'SYS_001':
                    case 'SYS_002':
                        // System error
                        this.toast.error('Lỗi hệ thống, vui lòng thử lại sau');
                        break;
                    default:
                        // Business error — hiển thị message từ server
                        if (body?.message) {
                            this.toast.error(body.message);
                        }
                }
                return throwError(() => error);
            })
        );
    }
}
```

