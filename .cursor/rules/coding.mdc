## 10. ANGULAR / FRONTEND RULES

```typescript
// ✅ Dùng translate pipe cho mọi text hiển thị
<span>{{ 'pr.status.pending' | translate }}</span>    // ✅
<span>Đang chờ duyệt</span>                           // ❌ hardcode

// ✅ Dùng CSS variable, KHÔNG hardcode màu
.status-badge { color: var(--color-warning); }         // ✅
.status-badge { color: #f59e0b; }                      // ❌ hardcode

// ✅ Prefix ep- cho mọi shared component
<ep-button variant="primary">Tạo mới</ep-button>       // ✅
<button class="btn-primary">Tạo mới</button>           // ❌

// ✅ Lazy loading cho feature modules
const routes: Routes = [
  { path: 'procurement', loadChildren: () => import('./procurement/procurement.module') }
];

// ✅ OnPush change detection strategy
@Component({ changeDetection: ChangeDetectionStrategy.OnPush })

// ✅ Unsubscribe với takeUntilDestroyed
this.service.data$.pipe(takeUntilDestroyed(this.destroyRef)).subscribe(...)
