## 2. DOCKERFILE CHUẨN (SPRING BOOT)

```dockerfile
# ✅ Multi-stage build — giảm image size
FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /app

# Copy pom.xml trước để cache layer dependencies
COPY pom.xml .
COPY .mvn/ .mvn/
COPY mvnw .
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B

# Copy source và build
COPY src/ ./src/
RUN ./mvnw package -DskipTests -B

# ─────────────────────────────────────────────────────────────
# Runtime image — chỉ JRE, không JDK (nhỏ hơn ~200MB)
FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app

# ✅ Tạo non-root user cho security
RUN addgroup -S eprocure && adduser -S eprocure -G eprocure
USER eprocure

# ✅ OpenTelemetry Java Agent
COPY --from=builder /root/.m2/repository/io/opentelemetry/javaagent/ ./agents/
# Hoặc download cố định:
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.0.0/opentelemetry-javaagent.jar ./agents/

# ✅ Copy JAR từ builder stage
COPY --from=builder /app/target/*.jar app.jar

# ✅ Expose port
EXPOSE 8080

# ✅ JVM options: tối ưu cho container + OTel agent
ENV JAVA_OPTS="-Xms128m -Xmx384m \
    -XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:+UseG1GC \
    -XX:+OptimizeStringConcat \
    -Djava.security.egd=file:/dev/./urandom \
    -javaagent:/app/agents/opentelemetry-javaagent.jar"

# ✅ Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget -q --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
```

