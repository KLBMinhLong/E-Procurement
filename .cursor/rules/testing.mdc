## 5. DOMAIN MODEL TEST

```java
// ✅ Test domain logic thuần (không cần mock)
class PurchaseRequestTest {

    @Test
    @DisplayName("PR có thể submit khi ở trạng thái DRAFT")
    void should_transition_to_submitted_when_submitted_from_draft() {
        // Given
        PurchaseRequest pr = PurchaseRequest.create(validCommand(), "PR-2025-01-00001");
        assertThat(pr.getStatus()).isEqualTo(PrStatus.DRAFT);

        // When
        pr.submit();

        // Then
        assertThat(pr.getStatus()).isEqualTo(PrStatus.SUBMITTED);
        assertThat(pr.getSubmittedAt()).isNotNull();
    }

    @Test
    @DisplayName("PR không thể submit khi đang PENDING_APPROVAL")
    void should_throw_when_submitting_from_pending_approval() {
        // Given
        PurchaseRequest pr = buildPrInStatus(PrStatus.PENDING_APPROVAL);

        // When/Then
        assertThatThrownBy(pr::submit)
            .isInstanceOf(InvalidStateTransitionException.class)
            .satisfies(ex -> assertThat(((InvalidStateTransitionException) ex).getErrorCode())
                .isEqualTo("PR_010"));
    }

    @Test
    @DisplayName("calculateTotalAmount tính đúng tổng từ line items")
    void should_calculate_total_correctly_from_line_items() {
        // Given
        PurchaseRequest pr = PurchaseRequest.create(validCommand(), "PR-2025-01-00001");
        // Line items: 2 × 35M + 1 × 5M = 75M
        assertThat(pr.getTotalAmount().getAmount())
            .isEqualByComparingTo(new BigDecimal("75000000.0000"));
    }

    @Test
    @DisplayName("Money arithmetic không có floating point error")
    void should_calculate_money_without_floating_point_error() {
        Money a = new Money(new BigDecimal("35000000.0000"), "VND");
        Money b = new Money(new BigDecimal("35000000.0000"), "VND");
        Money result = a.add(b);

        // Phải chính xác tuyệt đối — không có 69999999.9999...
        assertThat(result.getAmount())
            .isEqualByComparingTo(new BigDecimal("70000000.0000"));
    }
}
```

